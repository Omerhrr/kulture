# ---- Kaduna Kulture production settings (copy to .env on the VPS) -------
# Never commit the real .env. Generate secrets with:
#   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

KK_DOMAIN=kulture.rogan.live

# How the site is put online - pick ONE:
#  a) this server runs nothing else: let the stack's own Caddy take 80/443
# COMPOSE_PROFILES=standalone
#  b) another reverse proxy already owns 80/443 (shared server): join its network
COMPOSE_FILE=docker-compose.yml:infra/compose.shared-proxy.yml
PROXY_NETWORK=CHANGE_ME_proxy_network_name
KK_ENV=production

# Database (Postgres runs in the stack; only reachable inside it)
POSTGRES_USER=kk
POSTGRES_DB=kaduna
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# Login tokens - 32+ random characters, the server refuses to start without it
KK_JWT_SECRET=CHANGE_ME_long_random_secret

# Lightning: "mock" until a real node is connected (docs/lightning-integration.md).
# With KK_ENV=production the "simulate wallet payment" button is off.
KK_LIGHTNING_PROVIDER=mock
KK_INVOICE_EXPIRY_SECONDS=600
# KK_WEBHOOK_BEARER=
# KK_WEBHOOK_SECRET=

# In-game Ask guide / NPC agents (DeepSeek). Leave disabled to use the
# built-in FAQ answers.
KK_LLM_ENABLED=false
KK_LLM_BASE_URL=https://api.deepseek.com/v1
KK_LLM_MODEL=deepseek-chat
# KK_LLM_API_KEY=sk-...
KK_ASK_RATE_PER_MINUTE=8

KK_SHIFT_SECONDS=180
KK_AD_PRICE_SATS_PER_DAY=1000
KK_AD_MAX_DAYS=7
KK_ADS_AUTO_APPROVE=false
# secret for /api/v1/admin/ads/* (header X-Admin-Token)
KK_ADMIN_TOKEN=CHANGE_ME_admin_token
