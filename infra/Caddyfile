# Kaduna Kulture - public entrypoint. Caddy gets and renews the HTTPS
# certificate for KK_DOMAIN automatically (ports 80 + 443 must be open and
# the domain's A record must point at this server).
#   /api/*  -> FastAPI      /ws/*  -> FastAPI WebSocket      /*  -> Nuxt

{$KK_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@backend path /api/* /ws/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}

# www. -> bare domain
www.{$KK_DOMAIN:localhost} {
	redir https://{$KK_DOMAIN:localhost}{uri} permanent
}
