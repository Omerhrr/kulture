# ---- runtime environment -------------------------------------------------
KK_ENV=local

# Database: SQLite (default, zero-config) or PostgreSQL in docker-compose.
# KK_DATABASE_URL=postgresql+asyncpg://kk:kk_dev_change_me@localhost:5432/kaduna

# Auth - generate a real secret for anything public:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KK_JWT_SECRET=dev-only-change-me-kaduna-kulture

# ---- Lightning ------------------------------------------------------------
# mock      = regtest-style simulator (dev/demo, structurally valid lnbcrt)
# ldk_node  = real LDK Node integration (see docs/lightning-integration.md)
KK_LIGHTNING_PROVIDER=mock
KK_INVOICE_EXPIRY_SECONDS=600

# Real-node settlement webhook (P1 hardening). /api/v1/payments/webhook stays
# disabled (503) until BOTH are set. Auth = bearer + HMAC-SHA256 over
# "{timestamp}.{raw_body}" + timestamp tolerance window.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# KK_WEBHOOK_BEARER=change-me-node-webhook-bearer
# KK_WEBHOOK_SECRET=change-me-node-webhook-hmac-secret
# KK_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# LDK node (only when provider=ldk_node) - NEVER expose publicly:
# KK_LDK_NODE_URL=http://127.0.0.1:8080
# KK_LDK_NODE_API_KEY=

# ---- DSH agents / model access (bring-your-own) ---------------------------
# Sandbox default: local OpenAI-compatible bridge (z-ai-web-dev-sdk).
# Production: point at DeepSeek's API.
# KK_LLM_BASE_URL=https://api.deepseek.com/v1
# KK_LLM_API_KEY=sk-...
KK_LLM_BASE_URL=http://127.0.0.1:8100/v1
KK_LLM_MODEL=deepseek-chat
KK_LLM_ENABLED=true
# The in-game Ask guide uses the same LLM settings (falls back to a built-in
# FAQ when no model is reachable). Requests per player per minute:
KK_ASK_RATE_PER_MINUTE=8
# Work shifts: real seconds a player must stay on site before a shift pays
KK_SHIFT_SECONDS=180
# Billboard adverts bought with Lightning
KK_AD_PRICE_SATS_PER_DAY=1000
KK_AD_MAX_DAYS=7
# false = a moderator approves each paid ad before it airs (recommended)
KK_ADS_AUTO_APPROVE=false
# secret for /api/v1/admin/ads/* (header X-Admin-Token); empty disables it
KK_ADMIN_TOKEN=

# ---- Safety ----------------------------------------------------------------
# Dev-only "simulate external wallet payment" endpoint. Auto-disabled unless
# KK_ENV=local AND this is true AND provider=mock.
KK_DEV_PAYMENT_SIMULATION=true
